APP_NAME="PGS"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8082
# For LAN access, run: scripts\update-ip.bat (auto-detects your LAN IP)
# Or manually set: APP_URL=http://YOUR_LAN_IP:8082

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Manila

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pgs_app
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false

# Required in production; use a strong secret for encrypted backup archives.
BACKUP_ARCHIVE_PASSWORD=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=pgs-cache-

# DB persistent connections reduce overhead on every request (reuse connection).
# Enable on XAMPP/LAN where the DB server is on the same machine.
DB_PERSISTENT=false

# Queue worker config (used by update-ip.bat NSSM service)
PGS_QUEUE_WORKER_TRIES=3
PGS_QUEUE_WORKER_TIMEOUT=120
PGS_QUEUE_WORKER_SLEEP=3
PGS_QUEUE_WORKER_BACKOFF=5
PGS_QUEUE_WORKER_MAX_JOBS=500
PGS_QUEUE_WORKER_MAX_TIME=3600

MEMCACHED_HOST=127.0.0.1


MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_ENCRYPTION=tls
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="pgs@example.ph"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
