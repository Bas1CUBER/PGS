# ─────────────────────────────────────────────────────────────────────────────
# PGS repository root guard.
#
# The blessed web entry point is the standalone LAN Apache instance on :8082
# with DocumentRoot app/public (see app/lan-apache/httpd-lan.conf); it never
# reads this file. Nothing else in this tree may be served directly by any
# vhost whose docroot reaches it (e.g. the XAMPP default vhost exposing
# htdocs on :80): runtime secrets (.env, scripts/db_credentials.bat),
# application internals, and dependencies live here.
# ─────────────────────────────────────────────────────────────────────────────

RewriteEngine On

# Deny every request that resolves into this subtree through an outer docroot.
RewriteRule ^ - [F,L]

# Defense in depth should a future vhost point at or below this directory.
Options -Indexes

# Never serve dotfiles (.env*, .git*) from anywhere in the subtree.
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Never serve credentials, dumps, logs, manifests, or internal docs.
<FilesMatch "(\.(bat|sql|log|lock|neon)$|^composer\.(json|lock)$|^package(-lock)?\.json$|^phpunit.*\.xml$|^DOCUMENTATION\.md$)">
  Require all denied
</FilesMatch>
